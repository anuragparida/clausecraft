[58.297963, "o", "\u001b[1m[4/7] (f) deviation table — 5 rows light up\u001b[0m\r\n\r\n  \u001b[2m(golden reference from demo/expected-deviations.yaml)\u001b[0m\r\n\r\n"]
[58.344998, "o", "  \u001b[1m\u001b[2mclause  severity              category                        label\u001b[0m\r\n  \u001b[2m------- --------              --------                        ---------------------------------------------\u001b[0m\r\n  \u001b[1mc1      \u001b[0m\u001b[33mmaterial\u001b[0m               \u001b[2mmissing_exclusions                        \u001b[0mdefinition (no carve-outs)\r\n  \u001b[1mc2      \u001b[0m\u001b[33mmaterial\u001b[0m               \u001b[2mterm_too_long                             \u001b[0mterm (5y + 5y)\r\n  \u001b[1mc3      \u001b[0m\u001b[33mmaterial\u001b[0m               \u001b[2mmissing_residual_knowledge_carveout       \u001b[0mresidual knowledge (none)\r\n  \u001b[1mc4      \u001b[0m\u001b[33mmaterial\u001b[0m               \u001b[2moffshore_jurisdiction                     \u001b[0mgoverning law (Cayman)\r\n  \u001b[1mc5      \u001b[0m\u001b[31munacceptable\u001b[0m           \u001b[2mdamages_cap_in_lieu_of_injunction         \u001b[0mremedies (cap + no injunction)\r\n\r\n  \u001b[32m✓\u001b[0m 5 deviations flagged: 4 material, 1 unacceptable\r\n  \u001b[2mlive spotter: 0/5 (placeholder LLM)  ·  static golden: 5/5\u001b[0m\r\n"]
[58.350967, "o", "\r\n"]
[80.352358, "o", "\u001b[1m[5/7] (g) Approve 2 of 5  →  (h) Generate Redline  →  (i) download\u001b[0m\r\n\r\n  \u001b[2m$ curl -sS -X POST http://localhost:18000/contracts/known-bad-nda.pdf/decisions \\\u001b[0m\r\n  \u001b[2m       -H 'Content-Type: application/json' \\\u001b[0m\r\n  \u001b[2m       -d '{\"decisions\":[{\"clause_id\":\"c1\",\"decision\":\"approve\"},{\"clause_id\":\"c5\",\"decision\":\"approve\"}]}'\u001b[0m\r\n"]
[80.434158, "o", "  \u001b[32m✓\u001b[0m decisions recorded: c1, c5  \u001b[2m(decisions=2, docx_bytes=0)\u001b[0m\r\n\r\n  \u001b[2m$ curl -sS -o demo/redline-from-cast.docx http://localhost:18000/contracts/known-bad-nda.pdf/redline.docx\u001b[0m\r\n"]
[80.442285, "o", "  \u001b[33m!\u001b[0m live redline: HTTP 404 (placeholder LLM)\r\n  \u001b[2mshowing demo/expected-redline.docx (static reference — what the system would produce with a real LLM)\u001b[0m\r\n"]
