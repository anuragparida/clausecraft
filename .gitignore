# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# uv
uv.lock

# Node
node_modules/
.pnpm-store/
dist/
build/
.vite/
*.tsbuildinfo

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env
.env
.env.local
.env.*.local
# Production env (per Phase 6 / card t_7a84ecb6). The .example
# template is committed; the real secrets (Postgres password, Langfuse
# NextAuth + Salt + Encryption key, backend API key) NEVER are.
.env.prod
.env.prod.local
# Caddy state (per Phase 6). Caddy's data dir holds the issued Let's
# Encrypt certs; keep that out of git.
caddy_data/
caddy_config/

# Generated / runtime
*.log
.coverage
coverage/
htmlcov/
clausecraft_postgres_data/

# Eval runs (Phase 2+; committed: .gitkeep, ignored: actual reports)
evals/runs/*.json
!evals/runs/.gitkeep

# Eval cache (PDF text, embeddings, golden YAMLs — re-built from inputs)
evals/.cache/*.json
!evals/.cache/.gitkeep

# Langfuse working data
langfuse-data/
