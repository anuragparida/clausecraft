# clausecraft — example environment
# Copy to `.env` and replace placeholders with real values. NO real secrets committed.

# ----- Postgres -----
POSTGRES_USER=clausecraft
POSTGRES_PASSWORD=clausecraft
POSTGRES_DB=clausecraft
POSTGRES_PORT=15432
# Used by the backend (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://clausecraft:clausecraft@localhost:15432/clausecraft
# Used by Alembic at migrate time (sync driver, talks to the same host:port).
DATABASE_URL_SYNC=postgresql+psycopg2://clausecraft:clausecraft@localhost:15432/clausecraft

# ----- Backend -----
BACKEND_PORT=18000

# ----- Frontend -----
FRONTEND_PORT=15173
# The frontend's dev server proxies API calls to this URL. Inside Docker it would be
# the service name; on the host we point to the published port.
VITE_API_URL=http://localhost:18000

# ----- Langfuse -----
LANGFUSE_WEB_PORT=13000
LANGFUSE_API_PORT=13001
# These keys are auto-generated by Langfuse's all-in-one image on first boot.
# In v0 we DO NOT bake real keys — the Langfuse client falls back to no-op tracing.
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder-not-a-real-key
LANGFUSE_SECRET_KEY=sk-lf-placeholder-not-a-real-key
LANGFUSE_HOST=http://langfuse:13000

# ----- LLM (Phase 2+, stubbed in Phase 0) -----
# Provider choice is a sub-decision. Placeholders only.
LLM_API_KEY=llm-placeholder-not-a-real-key
LLM_BASE_URL=https://api.example.invalid
LLM_MODEL=claude-sonnet-placeholder

# ----- Playbook / eval (Phase 2+) -----
PLAYBOOK_VERSION=0.0.0-dev
EVAL_SET_VERSION=0.0.0-dev
# Path to the counterparty matrix YAML. Resolved relative to
# the repo root in dev, or set to the absolute in-container
# path (``/playbook/counterparty_matrix.yaml``) when running
# inside docker-compose.
COUNTERPARTY_MATRIX_PATH=playbook/counterparty_matrix.yaml
# Root directory containing the playbook YAML baselines.
# Same resolution rule as COUNTERPARTY_MATRIX_PATH.
PLAYBOOK_BASELINES_ROOT=playbook
# ----- Embeddings (Phase 2) -----
# The Phase 2 playbook store embeds clauses with bge-m3 via the
# OpenAI-compatible ``/embeddings`` endpoint. Default points at
# OpenRouter (which exposes bge-m3 as ``baai/bge-m3``). Leave
# EMBEDDING_API_KEY as a placeholder to fall back to the
# deterministic offline embedding path (still runs the pipeline
# end-to-end, but F1 numbers will not be meaningful).
EMBEDDING_API_KEY=placeholder-not-a-real-key
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIM=1024

# ----- Disclaimer (sourced from DISCLAIMER.md, surfaced in UI footer) -----
DISCLAIMER_TEXT="clausecraft is a research project. It is not legal advice. Every flag is a suggestion; you are the decision-maker. Verify anything that matters."
