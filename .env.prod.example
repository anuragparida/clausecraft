# clausecraft — production environment template.
#
# Copy to `.env.prod` and run `./scripts/render-env-prod.sh` to fill
# the placeholder values with strong random secrets.
# NEVER commit `.env.prod` — it is in .gitignore.
#
# Usage from the prod deploy:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#       --env-file .env.prod up -d
#
# Required vars (no defaults — render-env-prod.sh fills them):
#   DOMAIN, POSTGRES_PASSWORD, LANGFUSE_NEXTAUTH_SECRET, LANGFUSE_SALT,
#   LANGFUSE_ENCRYPTION_KEY, BACKEND_API_KEY, LLM_API_KEY,
#   EMBEDDING_API_KEY.

# ----- Public hostname -----
# The bare apex (e.g. example.com). The frontend, backend, and
# langfuse all live at {app,api,langfuse}.${DOMAIN}. Update the DNS
# A/AAAA records for each of those subdomains to point at the
# host public IP after the stack is up.
DOMAIN=example.com

# ----- TLS / Let's Encrypt -----
# Email for Let's Encrypt registration and expiry alerts. Must be
# a real address you check. LetsEncrypt will email you roughly 14
# days before any cert expires.
ACME_EMAIL=ops@example.com

# ACME directory URL. Use the staging endpoint for the first
# deploy to avoid Let's Encrypt rate limits; flip to the
# production endpoint after staging certs validate.
# Staging:    https://acme-staging-v02.api.letsencrypt.org/directory
# Production: https://acme-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ----- Postgres -----
# Strong random password. The render script generates a 64-hex-char
# value via openssl rand -hex 32. Do not use the dev default.
# CHANGE_ME: POSTGRES_PASSWORD to openssl rand -hex 32
POSTGRES_USER=clausecraft
POSTGRES_PASSWORD=fill...32
# Postgres is NOT published to the host in prod. The backend and
# langfuse-web reach it via the docker network. Leave
# POSTGRES_HOST_PORT unset (or set to 0) to keep it unpublished.
POSTGRES_HOST_PORT=

# ----- Backend -----
# API key for the FastAPI backend. The frontend sends this on
# every request. Treat as a secret.
# CHANGE_ME: BACKEND_API_KEY to openssl rand -hex 32
BACKEND_API_KEY=fill...32
# Real LLM keys. The defaults in docker-compose.yml point at the
# MiniMax subscription for the LLM and OpenRouter for embeddings.
# Leave as the offline placeholder to fall back to the deterministic
# offline pipeline (still runs, but F1 numbers will not be meaningful).
# CHANGE_ME: LLM_API_KEY / EMBEDDING_API_KEY to your real provider keys
LLM_API_KEY=fill...32
# Embeddings key, same model as dev.
EMBEDDING_API_KEY=fill...32
# ----- Langfuse -----
# NextAuth secret — 32 random bytes hex-encoded. Used to sign
# session cookies. Treat as a secret.
# CHANGE_ME: LANGFUSE_NEXTAUTH_SECRET to openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=fill...32
# Salt for Langfuse password hashing. 32 random bytes hex-encoded.
# CHANGE_ME: LANGFUSE_SALT to openssl rand -hex 32
LANGFUSE_SALT=fill-via-the-render-script
# Langfuse v2 encryption key for at-rest data. Must be a 64-hex-char
# (32-byte) value. All-zeros is NOT safe in prod — render-env-prod.sh
# generates a real one.
# CHANGE_ME: LANGFUSE_ENCRYPTION_KEY to openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=fill-via-the-render-script
# Public-facing URL. MUST match what the Caddy route serves.
# Render-env-prod.sh rewrites this to https://langfuse.${DOMAIN}.
LANGFUSE_HOST=https://langfuse.${DOMAIN}

# ----- Playbook / eval -----
# In prod the playbook and matrix are baked into the backend image
# (bind-mounted from ./playbook in docker-compose.yml). The values
# below are the in-container paths.
COUNTERPARTY_MATRIX_PATH=/playbook/counterparty_matrix.yaml
PLAYBOOK_BASELINES_ROOT=/playbook
PLAYBOOK_VERSION=0.0.0-prod
EVAL_SET_VERSION=0.0.0-prod

# ----- Disclaimer -----
# Same text as the dev .env.example. Surfaced in the UI footer
# and in the redacted .docx export. Override if your prod deploy
# needs different legal language.
DISCLAIMER_TEXT="clausecraft is a research project. It is not legal advice. Every flag is a suggestion; you are the decision-maker. Verify anything that matters."
