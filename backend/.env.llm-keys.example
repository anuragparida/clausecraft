# clausecraft — runtime LLM + embedding keys
# Copy this file to ``backend/.env`` and fill in the three placeholders.
# DO NOT commit ``backend/.env`` to git.
#
# Routing (2026-06-07, per Anurag):
#   - LLM text calls      -> MiniMax  (api.minimax.io/v1, model MiniMax-M3)
#   - Embedding retrieval -> OpenRouter qwen/qwen3-embedding-8b
#
# Why remote, not local? Both a Sonnet-class LLM and an 8B-parameter
# embedding model are far outside the <2GB local-hosting budget.
#
# How the spotter uses these:
#   - spotter.py constructs ``openai.OpenAI(api_key=LLM_API_KEY,
#     base_url=LLM_BASE_URL)`` and calls
#     ``client.chat.completions.create(model=LLM_MODEL, ...)``.
#     This is the OpenAI SDK talking to MiniMax's OpenAI-compatible
#     endpoint at ``/v1/chat/completions`` (probed — endpoint exists,
#     returns 401 without key, real auth error in JSON).
#   - embeddings.py constructs ``openai.OpenAI(api_key=EMBEDDING_API_KEY,
#     base_url=EMBEDDING_BASE_URL)`` and calls
#     ``client.embeddings.create(model=EMBEDDING_MODEL, ...)``.
#     OpenRouter's OpenAI-compat /api/v1/embeddings.
#
# Both clients fall back to a deterministic offline path when the
# key is missing or a placeholder, so the pipeline still produces
# non-null outputs for end-to-end smoke tests. The placeholders
# below are the conservative default.

# --- Paste your real MiniMax API key on the next line (sk-... or sk-cp-...) ---
LLM_API_KEY=sk-minimax-PASTE-YOUR-MINIMAX-KEY-HERE
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3

# --- Paste your real OpenRouter API key on the next line (sk-or-v1-...) ---
EMBEDDING_API_KEY=sk-or-v1-PASTE-YOUR-OPENROUTER-KEY-HERE
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=1024
